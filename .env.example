# AgroKart Environment Configuration Template
# Copy this file to .env and populate with your local/production settings.
# DO NOT COMMIT ACTUAL SECRET VALUES TO GIT.

# ─── Node.js Server Environment ───
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/agrokart
JWT_SECRET=your_jwt_secret_key_here
RAG_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Frontend Environment (React) ───
REACT_APP_API_URL=http://localhost:5000
REACT_APP_RAG_SERVICE_URL=http://localhost:8000

# ─── Python RAG Service Environment ───
RAG_PORT=8000
CHROMA_DB_DIR=./chroma_db
DOC_DIR=./data/agricultural_docs
